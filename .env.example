# Supabase dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Service role key â€” used ONLY in API routes (never exposed to the browser)
# Supabase dashboard -> Project Settings -> API -> service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=sb_secret_YOUR-SECRET-KEY

# Optional email OTP delivery (Resend; not used by the current registration forms)
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=Castrol FastScan <verify@your-verified-domain.example>
# Server-side secret used by contact verification (including SMS OTP)
CONTACT_OTP_SECRET=GENERATE-A-LONG-RANDOM-SECRET
# Local testing only. The app also requires NODE_ENV=development for this bypass.
CONTACT_VERIFICATION_BYPASS=false

# SMS OTP delivery (Twilio Verify)
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=YOUR-TWILIO-AUTH-TOKEN
TWILIO_VERIFY_SERVICE_SID=VA...

# Live Google Sheets sync (server only; use google-apps-script/Code.gs)
GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
GOOGLE_SHEETS_SYNC_SECRET=GENERATE-A-LONG-RANDOM-SECRET
# Optional link shown to managers; this is a URL, not a secret.
NEXT_PUBLIC_GOOGLE_SHEET_URL=https://docs.google.com/spreadsheets/d/YOUR_SPREADSHEET_ID/edit
